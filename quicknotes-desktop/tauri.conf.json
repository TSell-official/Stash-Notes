{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickNotes",
  "version": "0.1.0",
  "identifier": "com.quicknotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickNotes — Sticky Board",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first sticky notes with FTS5 search and MCP access",
    "longDescription": "QuickNotes is a fast, local-first Windows notepad replacement: drag-and-drop sticky board, voice capture, global shortcut quick-capture, SQLite FTS5 search, a CLI, and an MCP server so AI agents can read and write your notes.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
